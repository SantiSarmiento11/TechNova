# Servidor Web
SERVER_PORT=8080

# Conexión Base de Datos PostgreSQL 15+
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/TechNovaTest
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin123

# Configuración JWT (Seguridad)
# Debe ser una cadena de al menos 256 bits (32 bytes) para algoritmo HS256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiración en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000
